[
  {
    "assertUi": "viewport=(1920, 1080)",
    "label": "根视口 1920×1080"
  },
  {
    "click": "开始游戏",
    "label": "标题屏「开始游戏」"
  },
  {
    "wait": 10,
    "label": "推进 10 步"
  },
  {
    "click": "Dock",
    "label": "命令栏「停靠」"
  },
  {
    "click": "Destination0",
    "label": "目的地「贫城」"
  },
  {
    "eval": "var w=Main.World!; for(int i=0;i<600;i++){ if(w.IsDocked) break; Main.AdvanceToDebug(w.Tick+10);} return \"tick=\"+w.Tick+\" docked=\"+w.IsDocked;",
    "label": "等靠上贫城"
  },
  {
    "assert": "phase=poor_city",
    "label": "停靠成功"
  },
  {
    "eval": "var w=Main.World!; int n=0; while(w.Units.Count(u=>u.Role!=DemoFactory.Prototypes.BeastArena.Logic.UnitRole.Monster && u.State!=DemoFactory.Prototypes.BeastArena.Logic.UnitState.Dead && !u.LeftTown)<100){ w.Roster.Add(\"soak_\"+(n++), DemoFactory.Prototypes.BeastArena.Logic.UnitRole.FreePerson); } return \"units=\"+w.Units.Count;",
    "label": "把在场人形单位堆到 100（平时/聚集峰值那一档）"
  },
  {
    "sleep": 5.0,
    "label": "等五秒让新建的人的视图接满"
  },
  {
    "eval": "Main.ResetPerf(); return \"reset\";",
    "label": "清采样窗"
  },
