static func q(rx: float, ry: float = 0.0, rz: float = 0.0) -> Quaternion:
	return Basis.from_euler(Vector3(deg_to_rad(rx), deg_to_rad(ry), deg_to_rad(rz))).get_rotation_quaternion()


# 人形动作库 —— 轴口径（源场景约定「面朝 +Z」，四肢在绑定姿势里沿 -Y 下垂）：
#   下垂的部件（腿/手臂）：rx 负 = 向前摆，rx 正 = 向后摆；上指的部件（脊柱）：rx 正 = 前倾。
#   膝/肘只会向后弯，所以 shin 的 rx 恒为正。
# 位置轨道一期不用：见 export_glb.gd 顶部说明。
static func build(clip: String) -> Dictionary:
	match clip:
		"idle":
			return _idle()
		"walk":
			return _walk()
		"run":
			return _run()
		"attack_shoot":
			return _attack_shoot()
		"attack_melee":
			return _attack_melee()
		# 四条技能前摇的起手动作（该原型的技能体检单在表里给它们挂号，见
		# src/Prototypes/<原型>/Scripts/Logic/<前摇载体>.cs）。
		# 长度刻意**比前摇长**：起手段占满前摇（顶点落在 commit 那一刻），后面接出手与收招 ——
		# 前摇只有 0.2~0.3 秒，正好等长的动作肉眼读不出「这是什么招」，校验那头已允许演得久
		# （用户确认：前摇对表只咬「动画比前摇短」，见已删的验证报告）。
		"windup_slash":
			return _windup_slash()
		"windup_slam":
			return _windup_slam()
		"windup_pierce":
			return _windup_pierce()
		"windup_trample":
			return _windup_trample()
		"death":
			return _death()
		# ---- T12（巨兽竞技场垂直切片 · 对接面清单「2.2 人物八条」「2.3 原生怪七条」）----
		# hit / work / carry 补齐人物八条；hit / emerge 补齐原生怪七条。
		# 只加 clip，上面已有各条的关键帧一字不动。
		"hit":
			return _hit()
		"work":
			return _work()
		"carry":
			return _carry()
		"emerge":
			return _emerge()
	return {}


static func _track(bone: String, keys: Array) -> Array:
	# keys: [[时间秒, rx, ry, rz], ...]
	return [bone, keys]


static func _sine(steps: float, dur: float, amp: float, phase: float) -> Array:
	var keys := []
	var n := int(ceil(dur / steps))
	for i in n + 1:
		var t := minf(float(i) * steps, dur)
		keys.append([t, amp * sin(PI * 2.0 * (t / dur) + phase), 0.0, 0.0])
	return keys


static func _idle() -> Dictionary:
	var d := 3.2
	var s := d / 4.0
	return {
		"length": d, "loop": true,
		"tracks": [
			_track("chest", [[0, 0, 0, 0], [d * 0.5, 1.8, 0, 0], [d, 0, 0, 0]]),
			_track("head", [[0, -1.5, 2, 0], [d * 0.25, 0.5, -5, 0], [d * 0.6, 1.0, 6, 0], [d, -1.5, 2, 0]]),
			_track("armL", [[0, -1, 0, 3], [d * 0.5, 2, 0, 4.5], [d, -1, 0, 3]]),
			_track("armR", [[0, -1, 0, -3], [d * 0.5, 2, 0, -4.5], [d, -1, 0, -3]]),
			_track("hips", [[0, 0, 0, 1], [d * 0.5, 0, 2, -1], [d, 0, 0, 1]]),
			_track("spine", [[0, 0, -1, 0], [d * 0.5, 0, 1.5, 0], [d, 0, -1, 0]]),
			_track("thighL", _sine(s, d, 1.2, 0.0)),
			_track("thighR", _sine(s, d, 1.2, PI)),
		],
	}


