extends RefCounted

# 四足巨兽动作库 —— 「一头驮着小镇自己走的巨兽」这一件模型专用的 clip 表。
#
# 为什么第三座库：公共层原有两座（clips_humanoid.gd 走人形骨名、clips_mount.gd 是
# 「人骑在坐骑上」那一件的双骨架合并）。巨兽是**单副四足骨架**、肩上还驮着一整个小镇，
# 两座都不合用：套人形库，轨道按 hips/thighL 写的，骨架里根本没有这些骨名（导出时逐条 push_error
# 后动作全丢）；套骑乘库，坐骑那半能绑上，但那份 gait 是按战马比例写的简版，
# 而骑手上半身那几条轨道（_rider()）在单骨架上必然落空。
#
# 骨名一律带 m_ 前缀：骨架由 src/Tools/QuadrupedRig.cs 的 Quadruped.Rig 出，
# 那份把每根骨都叫 m_root / m_hips / m_spine / m_chest / m_neck / m_head / m_tail / m_saddle
# 与四条 m_legX / m_kneeX / m_hoofX（X ∈ FL FR BL BR）。前缀是为了与骑手那副人形骨防撞名，
# 本件不骑人、技术上多余，但换前缀会脱轨道 —— 与坐骑共用同一份画笔，绑定关系不能拆。
# 源场景里节点叫 j_m_hips，导出器 trim 掉 j_ 之后就是这里写的 m_hips。
#
# 轴口径与另两座库完全一致（源场景约定「面朝 +Z」，肢体在绑定姿势里沿 -Y 下垂）：
#   下垂的部件（腿）：rx 负 = 向前摆，rx 正 = 向后摆；膝/飞节只会向后弯，rx 恒为正。
#   上指的部件（脊柱）：rx 正 = 前倾（弓背）。
# 位置轨道一期不用（见 export_glb.gd 顶部说明）：身高起伏用脊柱与髋的旋转近似。
#
# 库里给哪几条：八条（T10，垂直切片规格「动作」的巨兽八条）——
# idle / walk / run 三条照旧，关键帧一个字不改；T10 追加 eat / lie_down / get_up /
# form_shift / advance 五条单发 clip（loop 全 false，终点交 AnimationFinished）。
# 名字与起止、接触点口径的冻结清单在 .scratch 的 interface.md「巨兽八条」表里。
# 登记表 Tools/ExportModels.gd 的 BEAST_CLIPS 跟着这八条走。


static func build(clip: String) -> Dictionary:
	match clip:
		"idle":
			return _idle()
		"walk":
			return _walk()
		"run":
			return _run()
		"eat":
			return _eat()
		"lie_down":
			return _lie_down()
		"get_up":
			return _get_up()
		"form_shift":
			return _form_shift()
		"advance":
			return _advance()
	return {}


static func _track(bone: String, keys: Array) -> Array:
	# keys: [[时间秒, rx, ry, rz], ...]
	return [bone, keys]


static func _sine(steps: float, dur: float, amp: float, phase: float) -> Array:
	var keys := []
	var n := int(ceil(dur / steps))
	for i in n + 1:
		var t := minf(float(i) * steps, dur)
		keys.append([t, amp * sin(PI * 2.0 * (t / dur) + phase), 0.0, 0.0])
	return keys


## 站着不动但不僵住：背线随呼吸一涨一落，脖子慢慢抬放，尾巴甩两下赶虫，
## 四条腿只换重心（±1.4°）。4.0 秒一条循环比人形的 3.2 秒长 —— 体型越大呼吸越慢。
static func _idle() -> Dictionary:
	var d := 4.0
	return {
		"length": d, "loop": true,
		"tracks": [
			_track("m_spine", [[0, 0, 0, 0], [d * 0.5, -1.8, 0, 0], [d, 0, 0, 0]]),
			_track("m_hips", [[0, 0, 0, 0], [d * 0.5, 1.3, 0, 0], [d, 0, 0, 0]]),
			_track("m_chest", [[0, 0, 0, 0], [d * 0.5, 1.1, 0, 0], [d, 0, 0, 0]]),
			_track("m_neck", [[0, 0, 0, 0], [d * 0.33, -4, 0, 0], [d * 0.7, 2.5, 5, 0], [d, 0, 0, 0]]),
			_track("m_head", [[0, 0, 0, 0], [d * 0.25, -5, 10, 0], [d * 0.6, 3, -12, 0], [d, 0, 0, 0]]),
			_track("m_tail", [[0, 0, 12, 0], [d * 0.18, 0, 15, 0], [d * 0.4, 0, -13, 0],
					[d * 0.65, 0, 10, 0], [d, 0, 12, 0]]),
			_track("m_legFL", _sine(d / 4.0, d, 1.4, 0.0)),
			_track("m_legFR", _sine(d / 4.0, d, 1.4, PI)),
			_track("m_legBL", _sine(d / 4.0, d, 1.1, PI * 0.5)),
			_track("m_legBR", _sine(d / 4.0, d, 1.1, PI * 1.5)),
		],
	}


## 慢步是四步落脚：左后 → 左前 → 右后 → 右前，相位各错开四分之一周期。
## 1.6 秒一条（人形 0.92 秒、坐骑 1.15 秒）—— 步幅随体量变大，周期跟着变长。
static func _walk() -> Dictionary:
	var d := 1.6
	var ph := {"BL": 0.0, "FL": PI * 0.5, "BR": PI, "FR": PI * 1.5}
	return {
		"length": d, "loop": true,
		"tracks": [
			_track("m_legBL", _sine(0.2, d, 15.0, ph["BL"])),
			_track("m_legFL", _sine(0.2, d, 16.0, ph["FL"])),
			_track("m_legBR", _sine(0.2, d, 15.0, ph["BR"])),
			_track("m_legFR", _sine(0.2, d, 16.0, ph["FR"])),
			# 膝/飞节只往后收（rx 正），且只在摆动相弯 —— 支撑相保持接近伸直，四蹄才不拖地
			_track("m_kneeBL", [[0, 10, 0, 0], [d * 0.125, 20, 0, 0], [d * 0.25, 8, 0, 0],
					[d * 0.5, 5, 0, 0], [d * 0.75, 8, 0, 0], [d * 0.875, 20, 0, 0], [d, 10, 0, 0]]),
			_track("m_kneeFL", [[0, 6, 0, 0], [d * 0.25, 4, 0, 0], [d * 0.375, 26, 0, 0],
					[d * 0.5, 12, 0, 0], [d * 0.75, 5, 0, 0], [d, 6, 0, 0]]),
			_track("m_kneeBR", [[0, 8, 0, 0], [d * 0.25, 5, 0, 0], [d * 0.5, 10, 0, 0],
					[d * 0.625, 20, 0, 0], [d * 0.75, 8, 0, 0], [d, 8, 0, 0]]),
			_track("m_kneeFR", [[0, 12, 0, 0], [d * 0.25, 5, 0, 0], [d * 0.5, 6, 0, 0],
					[d * 0.75, 26, 0, 0], [d * 0.875, 12, 0, 0], [d, 12, 0, 0]]),
			# 蹄只在离地相翻一下
			_track("m_hoofBL", [[0, -3, 0, 0], [d * 0.2, 9, 0, 0], [d, -3, 0, 0]]),
			_track("m_hoofFL", [[0, -4, 0, 0], [d * 0.45, 10, 0, 0], [d, -4, 0, 0]]),
			_track("m_hoofBR", [[0, 8, 0, 0], [d * 0.6, -3, 0, 0], [d, 8, 0, 0]]),
			_track("m_hoofFR", [[0, 10, 0, 0], [d * 0.7, -4, 0, 0], [d, 10, 0, 0]]),
			# 背随步伐起伏 + 一点侧摆；颈与头反向平衡（走兽的读法主要在这一对）
			_track("m_spine", [[0, 2.5, 0, 0], [d * 0.25, 0, 1.8, 0], [d * 0.5, -2.5, 0, 0],
					[d * 0.75, 0, -1.8, 0], [d, 2.5, 0, 0]]),
			_track("m_chest", [[0, -2, 0, 0], [d * 0.5, 2, 0, 0], [d, -2, 0, 0]]),
			_track("m_hips", [[0, 0, 1.4, 0], [d * 0.25, 0, 0, 0], [d * 0.5, 0, -1.4, 0],
					[d * 0.75, 0, 0, 0], [d, 0, 1.4, 0]]),
			_track("m_neck", [[0, -3, 0, 0], [d * 0.25, -1, 2.5, 0], [d * 0.5, -4, 0, 0],
					[d * 0.75, -1, -2.5, 0], [d, -3, 0, 0]]),
			_track("m_head", [[0, 3.5, 0, 0], [d * 0.25, 1, 3, 0], [d * 0.5, 5, 0, 0],
					[d * 0.75, 1, -3, 0], [d, 3.5, 0, 0]]),
			_track("m_tail", [[0, 0, 7, 0], [d * 0.5, 0, -7, 0], [d, 0, 7, 0]]),
		],
	}


