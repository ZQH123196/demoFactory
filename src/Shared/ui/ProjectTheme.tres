[gd_resource type="Theme" load_steps=3 format=3]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Microsoft YaHei", "微软雅黑", "Noto Sans SC", "Noto Sans CJK SC", "SimHei", "SimSun", "WenQuanYi Zen Hei", "PingFang SC", "Heiti SC", "sans-serif")
allow_system_fallback = true
subpixel_positioning = 1

[resource]
default_font = SubResource("SystemFont_ui")
default_font_size = 16
